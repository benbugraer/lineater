{
  "name": "lineater-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run apps/lineater/src/main.ts",
    "start": "bun run apps/lineater/src/main.ts",
    "build": "bun build apps/lineater/src/main.ts --compile --minify --outfile dist/lineater",
    "build:web": "bun run --cwd apps/web build",
    "build:release": "./scripts/build-release.sh",
    "lint": "bunx biome lint",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:installer": "./scripts/install.test.sh",
    "profile:startup": "bun scripts/profile-startup.ts",
    "db:generate": "bunx drizzle-kit generate --config packages/storage/drizzle.config.ts",
    "db:studio": "bunx drizzle-kit studio --config packages/storage/drizzle.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@effect/tsgo": "^0.44.0",
    "@libsql/client": "^0.18.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "toml": "4.2.0"
  },
  "dependencies": {
    "@effect/cli": "^0.77.1",
    "@effect/platform": "^0.97.2",
    "@effect/platform-bun": "^0.91.2",
    "effect": "^3.22.2"
  }
}
