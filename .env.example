# Public OAuth application identifier. Copy this file to .env and set the value locally.
LINEATER_LINEAR_CLIENT_ID=a90b344953014fa321489a3961607b6f

# Must exactly match the redirect URI registered in the Linear OAuth application.
LINEATER_LINEAR_REDIRECT_URI=http://127.0.0.1:45432/oauth/callback

# Least-privilege scopes currently required by Lineater. Never add admin.
LINEATER_LINEAR_SCOPES=read,write

# Optional local overrides. Leave empty to use XDG/platform defaults.
# LINEATER_DATABASE_PATH=/absolute/path/to/lineater.db
# LINEATER_LOG_PATH=/absolute/path/to/lineater.log

# Intentionally absent:
# - LINEATER_LINEAR_CLIENT_SECRET: native CLI uses OAuth PKCE and must not ship a secret.
# - LINEAR_API_KEY/developer token: personal long-lived credentials are not supported.
